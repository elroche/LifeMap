<!DOCTYPE html> <html lang="fr"> <head>
<meta charset="UTF-8">

<title>{% block title %}LifeMap{% endblock %}</title>


{# =========================
   CSS
   ========================= #}

<link rel="stylesheet" href="{{ asset('css/app.css') }}">

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet">

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


{# =========================
   JAVASCRIPT / IMPORTMAP
   ========================= #}

{% block javascripts %}

    {% block importmap %}
        {{ importmap('app') }}
    {% endblock %}

{% endblock %}


{# =========================
   FRANKENPHP HOT RELOAD
   ========================= #}

{% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}

{% if frankenphpHotReload %}

    <meta name="frankenphp-hot-reload:url"
          content="{{ frankenphpHotReload }}">

    <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>

    <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm"
            type="module"></script>

{% endif %}

</head> <body class="{{ app.user ? 'authenticated' : 'guest' }}">
{# Route courante utilisée pour déterminer le lien actif de la sidebar #}

{% set currentRoute = app.request.attributes.get('_route') %}


{# =========================
   SIDEBAR
   ========================= #}

<nav class="sidebar">

    <a href="{{ path('app_home') }}"
       class="{{ currentRoute == 'app_home' ? 'active' : '' }}">

        <i class="bi bi-house"></i>
        Accueil

    </a>


    <a href="{{ path('app_event_index') }}"
       class="{{ currentRoute == 'app_event_index' ? 'active' : '' }}">

        <i class="bi bi-calendar"></i>
        Evénements

    </a>


    <a href="#"
       class="{{ currentRoute == 'app_timeline' ? 'active' : '' }}">

        <i class="bi bi-clock"></i>
        Chronologie

    </a>


    <a href="#"
       class="{{ currentRoute == 'app_event_create' ? 'active' : '' }}">

        <i class="bi bi-plus-circle"></i>
        Ajouter un événement

    </a>


    <a href="#"
       class="{{ currentRoute == 'app_skills' ? 'active' : '' }}">

        <i class="bi bi-trophy"></i>
        Compétences et tags

    </a>


    <a href="#"
       class="{{ currentRoute == 'app_stats' ? 'active' : '' }}">

        <i class="bi bi-bar-chart-line"></i>
        Analyses et statistiques

    </a>


    <a href="#"
       class="{{ currentRoute == 'app_favorites' ? 'active' : '' }}">

        <i class="bi bi-heart"></i>
        Favoris

    </a>

</nav>


{# =========================
   ZONE PRINCIPALE
   ========================= #}

<div class="main-container">


    {# =========================
       TOPBAR
       ========================= #}

    <header class="topbar">

        <form class="search-form">

            <div class="search-wrapper">

                <i class="fa-solid fa-magnifying-glass search-icon"></i>

                <input
                    type="text"
                    placeholder="Rechercher un événement..."
                    class="search-input">

            </div>

        </form>


        <div class="dropdown">

            <button
                class="btn btn-light border d-flex align-items-center gap-4 dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
            >

                <i class="bi bi-person user-icon"></i>

                <div>

                    <div>
                        {{ app.user.username ?: app.user.firstname }}
                    </div>

                    {% if is_granted('ROLE_ADMIN') %}

                        <div class="user-role">
                            Admin
                        </div>

                    {% endif %}

                </div>

            </button>


            <ul class="dropdown-menu dropdown-menu-end">

                <li>

                    <a class="dropdown-item"
                       href="{{ path('app_account') }}">

                        <i class="bi bi-gear me-2"></i>
                        Gestion du compte

                    </a>

                </li>


                <li>
                    <hr class="dropdown-divider">
                </li>


                <li>

                    <a class="dropdown-item text-danger"
                       href="{{ path('app_logout') }}">

                        <i class="bi bi-box-arrow-right me-2"></i>
                        Déconnexion

                    </a>

                </li>

            </ul>

        </div>

    </header>


    {# =========================
       CONTENU CONNECTÉ
       ========================= #}

    <main class="content">

        {% for type, messages in app.flashes %}

            {% for message in messages %}

                <div class="alert alert-{{ type }} alert-dismissible fade show"
                     role="alert">

                    {{ message }}

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                    </button>

                </div>

            {% endfor %}

        {% endfor %}


        {% block authenticated_body %}{% endblock %}

    </main>

</div>


{# =========================
   BOOTSTRAP JAVASCRIPT
   ========================= #}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body> </html>