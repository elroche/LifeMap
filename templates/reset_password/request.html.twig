{% extends 'base.html.twig' %}

{% block title %}Modifier votre mot de passe{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm border-1">
                <div class="card-body p-4">

                    {% for flash_error in app.flashes('reset_password_error') %}
                        <div class="alert alert-danger" role="alert">
                            {{ flash_error }}
                        </div>
                    {% endfor %}

                    <h1 class="h3 text-center mb-4">
                        Modifier votre mot de passe
                    </h1>

                    {{ form_start(requestForm) }}

                        <div class="mb-3">
                            {{ form_label(requestForm.email) }}
                            {{ form_widget(requestForm.email, {
                                attr: {
                                    class: 'form-control',
                                    autocomplete: 'email'
                                }
                            }) }}
                            {{ form_errors(requestForm.email) }}
                        </div>

                        <div class="mb-4">
                            <small class="text-muted">
                                Entrez votre adresse mail, et nous vous enverrons
                                un lien pour modifier votre mot de passe.
                            </small>
                        </div>

                        <button class="btn btn-primary w-100" type="submit">
                            Envoyer un mail
                        </button>

                    {{ form_end(requestForm) }}

                    <hr class="my-4">

                    <div class="text-center">
                        <span class="text-muted">
                            Vous avez retrouvé votre mot de passe ?
                        </span>
                        <br>
                        <a href="{{ path('app_login') }}"
                           class="btn btn-outline-secondary mt-2">
                            Se connecter
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}