{% extends 'base.html.twig' %}

{% block title %}E-mail de réinitialisation envoyé{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm border-1">
                <div class="card-body p-4">

                    <h1 class="h3 text-center mb-4">
                        E-mail envoyé
                    </h1>

                    <div class="text-center">
                        <p>
                            Si un compte correspondant à votre adresse e-mail existe déjà,
                            un e-mail contenant un lien vous permettant de réinitialiser
                            votre mot de passe vient de vous être envoyé.
                        </p>

                        <p class="text-muted">
                            Ce lien expirera dans
                            {{ resetToken.expirationMessageKey|trans(
                                resetToken.expirationMessageData,
                                'ResetPasswordBundle'
                            ) }}.
                        </p>
                    </div>

                    <div class="alert alert-info mt-4" role="alert">
                        Si vous ne recevez pas d'e-mail, veuillez vérifier votre dossier
                        de courriers indésirables.
                    </div>

                    <div class="text-center mt-4">
                        <a href="{{ path('app_forgot_password_request') }}"
                           class="btn btn-primary w-100">
                            Renvoyer un e-mail
                        </a>
                    </div>

                    <hr class="my-4">

                    <div class="text-center">
                        <span class="text-muted">
                            Vous avez retrouvé votre mot de passe ?
                        </span>
                        <br>
                        <a href="{{ path('app_login') }}"
                           class="btn btn-outline-secondary mt-2">
                            Se connecter
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}